# Enrichment gateway (firmographics, funding, tech stack, titles, people, email verification)
GATEWAY_URL=
GATEWAY_API_KEY=

# Scraper platform (company profile + job postings). Optional: without it those two steps report a miss reason and the rest still fills.
SCRAPER_TOKEN=

# Waterfall phone finder (optional, --mobile runs only). Needs the phone add-on on the account; 10 credits per mobile found, nothing on a miss.
PHONE_API_KEY=

# Postgres database (optional). Use the secret / service-role key, never the publishable key. Run schema.sql once before the first run.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
